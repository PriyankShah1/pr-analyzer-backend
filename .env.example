# Copy to .env. The real .env is gitignored — never commit a token.

# Server-side fallback for GitHub reads. OPTIONAL.
#   without it : 60 requests/hour (anonymous)
#   with it    : 5,000 requests/hour
# A token the user pastes into the UI always takes precedence over this one.
#
# SCOPES: for PUBLIC pull requests, none at all. A classic token with every
# box unticked authenticates you, raises the rate limit, and is enough to post
# comments as yourself.
#   - reading a private repo  → classic `repo`, or fine-grained Contents: Read
#   - committing a suggested fix → write access to repository CONTENTS:
#     classic `public_repo` (public) / `repo` (private), or fine-grained
#     Contents: Read and write. That is a different permission from
#     "Pull requests" — a fix is written as a real commit on the PR branch.
#
# A fine-grained token scoped to "Public repositories" is READ-ONLY and cannot
# comment or commit, with no setting shown to indicate that.
GITHUB_TOKEN=

# Enables the in-depth review, AI explanations, and suggested fixes.
# Everything else works without it: the static rules, the graph, and the
# comment-posting flow are deterministic and never call a model.
GEMINI_API_KEY=

# Comma-separated origins allowed to call this API. MUST be set in production
# or the deployed frontend is refused by CORS.
ALLOWED_ORIGINS=http://localhost:5173

# Render sets PORT itself. Leave unset there.
PORT=3001
